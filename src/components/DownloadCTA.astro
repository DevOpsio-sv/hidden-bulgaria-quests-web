---
import type { Dict } from "../i18n";
import { APP_STORE_URL, GOOGLE_PLAY_URL } from "../config/appLinks";
interface Props { dict: Dict; }
const { dict } = Astro.props;
const d = dict.download;
const stores = [
  { ...d.appStore, url: APP_STORE_URL },
  { ...d.googlePlay, url: GOOGLE_PLAY_URL },
];
---

<div class="dl-band" id="download">
  <div class="wrap">
    <p class="eyebrow" style="text-align:center">{d.eyebrow}</p>
    <h2 class="reveal">{d.heading}</h2>
    <p class="lede reveal reveal-d1">{d.lede}</p>

    <div class="store-row reveal reveal-d2">
      {stores.map((s) => (
        s.url ? (
          <a
            class="store-btn"
            href={s.url}
            aria-label={`${s.label} ${s.name}`}
          >
            <span class="store-lbl">{s.label}</span>
            <span class="store-name">{s.name}</span>
          </a>
        ) : (
          <button
            class="store-btn store-btn-soon"
            type="button"
            disabled
            aria-label={`${s.label} ${s.name} — ${d.comingSoon}`}
          >
            <span class="store-lbl">{s.label}</span>
            <span class="store-name">{s.name}</span>
            <span class="store-soon">{d.comingSoon}</span>
          </button>
        )
      ))}
    </div>

    <p class="dl-trust reveal reveal-d3">{d.trust}</p>
  </div>
</div>
