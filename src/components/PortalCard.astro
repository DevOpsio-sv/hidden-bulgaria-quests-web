---
import type { Dict } from "../i18n";
import { firstPlacePath } from "../config/appLinks";

interface Props {
  dict: Dict;
  lang: string;
}

const { dict, lang } = Astro.props;
const h = dict.hero;
const href = firstPlacePath(lang);
---

<a
  class="portal-card"
  href={href}
  aria-label={`${h.phoneTitle} — ${h.ctaFirstPlace}`}
>
  <video
    class="portal-cave-video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
  >
    <source src="/video/prohodna-portal.mp4" type="video/mp4" />
  </video>

  <div class="portal-panel">
    <div class="portal-panel-bg" aria-hidden="true"></div>
    <div class="portal-scanline" aria-hidden="true"></div>

    <div class="portal-copy" aria-hidden="true">
      <p class="portal-kicker">{h.phoneDomain}</p>
      <h2 class="portal-title">{h.phoneTitle}</h2>
      <p class="portal-description">{h.phoneDesc}</p>
      <span class="portal-cta">{h.ctaFirstPlace}</span>
    </div>
  </div>
</a>

<script>
  const pausePortalVideosForReducedMotion = () => {
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    document.querySelectorAll<HTMLVideoElement>(".portal-cave-video").forEach((video) => {
      video.pause();
      video.removeAttribute("autoplay");
    });
  };

  document.addEventListener("astro:page-load", pausePortalVideosForReducedMotion);
</script>

<style>
  .portal-card{
    color:inherit;
    display:block;
    flex-shrink:0;
    outline-offset:4px;
    position:relative;
    text-decoration:none;
    width:min(100%,320px);
  }

  .portal-card:focus-visible{
    outline:2px solid var(--gold-lt);
  }

  .portal-cave-video{
    border-radius:30px;
    height:100%;
    inset:0;
    object-fit:cover;
    opacity:.92;
    position:absolute;
    width:100%;
    z-index:0;
  }

  .portal-panel{
    border:1px solid var(--border);
    border-radius:30px;
    box-shadow:var(--glow-lg);
    min-height:380px;
    overflow:hidden;
    padding:30px 24px;
    position:relative;
    text-align:left;
    transition:border-color var(--fast) var(--ease),box-shadow var(--fast) var(--ease);
    z-index:1;
  }

  .portal-card:hover .portal-panel,
  .portal-card:focus-visible .portal-panel{
    border-color:rgba(216,181,106,.55);
    box-shadow:var(--glow-lg),0 0 0 1px rgba(216,181,106,.18);
  }

  .portal-panel-bg{
    background:
      radial-gradient(ellipse 78% 48% at 50% 8%,rgba(216,181,106,.18),transparent 70%),
      linear-gradient(180deg,rgba(8,16,31,.94),rgba(3,6,16,.98));
    inset:0;
    -webkit-mask-image:radial-gradient(ellipse 58% 34% at 50% 42%,transparent 0 46%,#000 61%);
    mask-image:radial-gradient(ellipse 58% 34% at 50% 42%,transparent 0 46%,#000 61%);
    opacity:.9;
    position:absolute;
    z-index:-2;
  }

  .portal-scanline{
    background:linear-gradient(90deg,transparent,rgba(216,181,106,.62),transparent);
    height:1px;
    left:18px;
    opacity:.5;
    position:absolute;
    right:18px;
    top:20px;
  }

  .portal-copy{
    display:flex;
    flex-direction:column;
    min-height:320px;
    position:relative;
    z-index:1;
  }

  .portal-kicker{
    color:var(--gold);
    font-family:var(--ff-title);
    font-size:.68rem;
    font-weight:700;
    letter-spacing:.22em;
    margin-bottom:10px;
    text-transform:uppercase;
  }

  .portal-title{
    color:var(--text-1);
    font-family:var(--ff-display);
    font-size:clamp(1.75rem,3.2vw,2.35rem);
    font-weight:500;
    line-height:1.05;
    margin-bottom:14px;
  }

  .portal-description{
    color:var(--text-2);
    font-size:.95rem;
    line-height:1.62;
  }

  .portal-cta{
    align-items:center;
    background:linear-gradient(135deg,var(--gold),var(--gold-dk));
    border-radius:var(--r-pill);
    box-shadow:var(--glow-sm);
    color:var(--bg-0);
    display:inline-flex;
    font-family:var(--ff-title);
    font-size:.78rem;
    font-weight:800;
    justify-content:center;
    letter-spacing:.14em;
    margin-top:auto;
    min-height:48px;
    padding:0 20px;
    text-align:center;
    text-transform:uppercase;
    transition:filter var(--fast) var(--ease),transform var(--fast) var(--ease);
    width:100%;
  }

  .portal-card:hover .portal-cta,
  .portal-card:focus-visible .portal-cta{
    filter:brightness(1.08);
    transform:translateY(-2px);
  }

  @media(max-width:1079px){
    .portal-card{
      margin-top:22px;
      width:min(100%,340px);
    }

    .portal-panel{
      min-height:300px;
      padding:22px 20px;
      text-align:left;
    }

    .portal-copy{min-height:256px}
  }

  @media(max-width:520px){
    .portal-card{width:100%}
    .portal-panel{
      border-radius:24px;
      min-height:260px;
      padding:18px 16px;
    }
    .portal-cave-video{border-radius:24px}
    .portal-copy{min-height:224px}
    .portal-title{font-size:1.5rem}
    .portal-description{font-size:.88rem;line-height:1.5}
    .portal-cta{font-size:.68rem;min-height:42px}
  }

  @media(prefers-reduced-motion:reduce){
    .portal-panel,
    .portal-cta{
      transition:none;
    }

    .portal-card:hover .portal-cta,
    .portal-card:focus-visible .portal-cta{
      transform:none;
    }
  }
</style>
