{
  "name": "hidden-bulgaria-quests-web",
  "version": "0.2.0",
  "private": true,
  "description": "Official product website for Unlocking Bulgaria — a premium real-world quest app for cultural exploration.",
  "scripts": {
    "dev": "astro dev",
    "build": "node --experimental-strip-types scripts/validate-place-identity.mjs && node --experimental-strip-types --test scripts/test-feature-flags.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "astro check",
    "validate:identity": "node --experimental-strip-types scripts/validate-place-identity.mjs",
    "test:identity": "node --experimental-strip-types --test scripts/test-place-identity.mjs",
    "test:features": "node --experimental-strip-types --test scripts/test-feature-flags.mjs",
    "check:seo-build": "node scripts/check-seo-build.mjs",
    "test:partner-form": "node --test scripts/test-partner-enquiry.mjs",
    "check:routes": "node scripts/check-seo-build.mjs",
    "check:language": "node scripts/check-seo-build.mjs",
    "check:sitemap": "node scripts/check-seo-build.mjs",
    "check:links": "node scripts/check-seo-build.mjs"
  },
  "dependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.9.3",
    "wrangler": "^4.95.0"
  }
}
